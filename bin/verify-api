#!/usr/bin/env bash
# 실제 EXAONE API의 도구 호출, 구조화 출력, rate limit 을 확인합니다 (게이트웨이 불필요).
set -euo pipefail
. "$(dirname "$0")/_env.sh"
if [ -z "${EXAONE_API_KEY:-}" ]; then
  echo ".env 의 EXAONE_API_KEY 가 비어 있습니다." >&2
  exit 1
fi
export EXAONE_API_KEY EXAONE_API_BASE
exec "$ROOT/.venv/bin/python" "$ROOT/tests/verify_api.py"
