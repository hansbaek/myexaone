#!/usr/bin/env bash
# Claude Code를 EXAONE으로 실행합니다. 인자는 claude 에 그대로 전달됩니다.
# 평소의 claude 설정과 로그인에는 영향을 주지 않습니다 (이 실행에만 적용).
set -euo pipefail
. "$(dirname "$0")/_env.sh"
require_gateway

# 설정은 --settings 로 넘깁니다. Claude Code는 셸 환경 변수보다 ~/.claude/settings.json 의
# env 값을 우선하므로, 그 파일에 ANTHROPIC_BASE_URL 이 있으면 export 만으로는 무시됩니다.
# --settings 는 사용자 설정 파일보다 우선합니다.
settings="$(
  GATEWAY_URL="$GATEWAY_URL" KEY="$LITELLM_MASTER_KEY" python3 - <<'PY'
import json, os
m = "k-exaone"
print(json.dumps({"env": {
    "ANTHROPIC_BASE_URL": os.environ["GATEWAY_URL"],
    "ANTHROPIC_AUTH_TOKEN": os.environ["KEY"],
    "ANTHROPIC_MODEL": m,
    # 보조 호출(제목 생성, 요약 등)도 전부 EXAONE으로 보냅니다.
    "ANTHROPIC_DEFAULT_OPUS_MODEL": m,
    "ANTHROPIC_DEFAULT_SONNET_MODEL": m,
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": m,
    "ANTHROPIC_SMALL_FAST_MODEL": m,
    # K-EXAONE 2.5 컨텍스트는 524,288 토큰(입력+출력). 출력 여유분을 빼고 알려 줍니다.
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "480000",
    # 한도가 낮으므로 필수 아닌 호출은 끕니다.
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
}}))
PY
)"

unset ANTHROPIC_API_KEY CLAUDECODE
# 설정 파일을 읽지 않는 경로를 위해 환경 변수도 같이 둡니다.
export ANTHROPIC_BASE_URL="$GATEWAY_URL"
export ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY"
exec claude --settings "$settings" --model k-exaone "$@"
