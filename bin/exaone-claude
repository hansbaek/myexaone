#!/usr/bin/env bash
# Claude Code를 EXAONE으로 실행합니다. 인자는 claude 에 그대로 전달됩니다.
# 평소의 claude 설정과 로그인에는 영향을 주지 않습니다 (이 프로세스의 환경 변수만 바꿈).
set -euo pipefail
. "$(dirname "$0")/_env.sh"
require_gateway

unset ANTHROPIC_API_KEY CLAUDECODE
export ANTHROPIC_BASE_URL="$GATEWAY_URL"
export ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY"
export ANTHROPIC_MODEL="k-exaone"
# 보조 호출(제목 생성, 요약 등)도 전부 EXAONE으로 보냅니다.
export ANTHROPIC_DEFAULT_OPUS_MODEL="k-exaone"
export ANTHROPIC_DEFAULT_SONNET_MODEL="k-exaone"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="k-exaone"
export ANTHROPIC_SMALL_FAST_MODEL="k-exaone"
# K-EXAONE 2.5 컨텍스트는 524,288 토큰(입력+출력). 출력 여유분을 빼고 알려 줍니다.
# 없으면 Claude Code가 모르는 모델로 보고 200k로 가정합니다.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=480000
# 한도가 낮으므로 필수 아닌 호출은 끕니다.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
exec claude "$@"
