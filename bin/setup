#!/usr/bin/env bash
# 최초 1회: .env 생성, 게이트웨이용 파이썬 환경 설치
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [ ! -f .env ]; then
  cp .env.example .env
  key="sk-local-$(openssl rand -hex 16)"
  sed -i '' "s|^LITELLM_MASTER_KEY=.*|LITELLM_MASTER_KEY=${key}|" .env
  chmod 600 .env
  echo ".env 를 만들었습니다."
fi

if [ ! -x .venv/bin/litellm ]; then
  [ -x .venv/bin/python ] || uv venv --python 3.12 .venv
  uv pip install --python .venv/bin/python -r requirements.txt
fi

if grep -q '^EXAONE_API_KEY=$' .env; then
  echo "다음 단계: .env 의 EXAONE_API_KEY 에 발급받은 키를 넣으세요."
else
  echo "준비 완료. bin/verify-api 로 API를 확인한 뒤 bin/gateway 를 실행하세요."
fi
