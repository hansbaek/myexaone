#!/usr/bin/env bash
# EXAONE API 키를 .env 에 저장합니다. 입력한 키는 화면과 셸 기록에 남지 않습니다.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="$ROOT/.env"
[ -f "$ENV_FILE" ] || { echo ".env 가 없습니다. 먼저 bin/setup 을 실행하세요." >&2; exit 1; }

printf "EXAONE API 키를 붙여넣고 Enter (화면에 표시되지 않습니다): "
IFS= read -rs key
echo
key="$(printf '%s' "$key" | tr -d '[:space:]')"
[ -n "$key" ] || { echo "입력이 비어 있어 변경하지 않았습니다." >&2; exit 1; }

tmp="$(mktemp "$ROOT/.env.XXXXXX")"
chmod 600 "$tmp"
KEY="$key" awk 'BEGIN{done=0}
  /^EXAONE_API_KEY=/ {print "EXAONE_API_KEY=" ENVIRON["KEY"]; done=1; next}
  {print}
  END{if(!done) print "EXAONE_API_KEY=" ENVIRON["KEY"]}' "$ENV_FILE" > "$tmp"
mv "$tmp" "$ENV_FILE"
echo "저장했습니다 (키 길이 ${#key}자). 이제 bin/verify-api 또는 bin/gateway 를 실행할 수 있습니다."
